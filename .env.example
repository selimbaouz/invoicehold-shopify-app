# Shopify (Partners Dashboard → App → Client credentials)
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
SHOPIFY_APP_URL="https://example.com"
SCOPES="write_draft_orders"

# Local Prisma uses SQLite (prisma/dev.sqlite). No Neon/Postgres account needed for shopify app dev.
# Later, for production only: switch schema.prisma provider to postgresql and set DATABASE_URL.
