# Local Prisma can use the same Neon DATABASE_URL as production.
# Do not commit real credentials.

# Shopify (Partners Dashboard → App → Client credentials)
SHOPIFY_API_KEY=""
SHOPIFY_API_SECRET=""
# Must include https:// (Shopify rejects a bare hostname).
SHOPIFY_APP_URL="https://example.com"
SCOPES="write_draft_orders"

# Production (Neon / Postgres). Local `shopify app dev` can use the same URL.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

